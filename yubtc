#!/usr/bin/env python3
"""Run YuBTC straight from a source checkout, without installing it.

Deliberately has no .py suffix so that it cannot be imported as a module and
shadow the real ``yubtc`` package in src/.
"""
import os
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)), 'src'))

from yubtc.cli import cli

if __name__ == '__main__':
    cli()
